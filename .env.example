# Environment configuration for pinboard
#
# Copy this file to .env next to docker-compose.yml and fill it in. Never
# commit .env.
#
# Only POSTGRES_PASSWORD is required. Everything else is optional: a value
# left unset falls back to the default shown, and an integration with no
# values stays off. At startup the app logs one line per integration saying
# whether it is on.
#
# Homelab only: scripts/deploy.sh also sources /app/secrets/global.env (or
# KEYRING_ENV) when that file exists, after this one, so a value rendered there
# by a secrets manager wins over the same name here. Without the file nothing changes.

# --- Required -----------------------------------------------------------------

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
POSTGRES_PASSWORD=changeme

# --- Optional: database and storage -------------------------------------------

# POSTGRES_DB=pinboard
# POSTGRES_USER=pinboard

# Host port for the app (API and PWA). Default 8095.
# APP_PORT=8095

# Where Postgres data and the nightly pg_dump backups live. Unset = the named
# Docker volumes pinboard-db and pinboard-backups. Set a host path to keep them
# on the host instead (the homelab LXC uses /app/sql and /app/backups;
# scripts/deploy.sh picks those up on its own when the directories exist next
# to the checkout).
# PINBOARD_SQL_DIR=/app/sql
# PINBOARD_BACKUP_DIR=/app/backups
# BACKUP_RETENTION_DAYS=7
# BACKUP_KEEP_MIN=3
# BACKUP_RETRY_SECONDS=900

# --- Optional: daily digest mail ----------------------------------------------

# The digest (what ran, what waits for review, what failed) goes out over SMTP
# submission. Off unless SMTP_HOST, SMTP_USER and SMTP_PASS are all set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Name to verify the mail server's certificate against when SMTP_HOST is an IP.
# SMTP_TLS_SERVERNAME=
# Recipient of the digest.
# DIGEST_TO=
# Hour of day (0-23, server-local time) the digest sends. Default 9.
# DIGEST_HOUR=9

# --- Optional: phone push (ntfy) ----------------------------------------------

# Off unless both NTFY_URL and NTFY_TOKEN_PINBOARD are set. The token is a
# publisher token for NTFY_TOPIC.
NTFY_URL=
NTFY_TOKEN_PINBOARD=
# NTFY_TOPIC=pinboard
# No pushes between these hours (PUSH_TIME_ZONE), then one digest at
# PUSH_DIGEST_AT. Defaults 1, 9, 9, Europe/Bratislava.
# PUSH_QUIET_START=1
# PUSH_QUIET_END=9
# PUSH_DIGEST_AT=9
# PUSH_TIME_ZONE=Europe/Bratislava
# Where a tapped notification opens: this app's public base URL.
# PINBOARD_PUBLIC_URL=

# --- Optional: PWA ------------------------------------------------------------

# Where account avatars live, as `<base><user id>`. Read at build time
# (rebuild after changing it). Empty shows initials.
# AVATAR_BASE_URL=

# --- Optional: root grants behind a reverse proxy -----------------------------

# Who may queue a `root-access` task, which approves an agent getting root on
# its containers through a root proxy. Off (the endpoint refuses everything)
# unless both are set. PINBOARD_PROXY_SECRET is a shared secret the reverse
# proxy in front of pinboard sends; OPERATOR_DEVICE_IPS are the operators' own
# devices (comma- or space-separated), never a server's.
PINBOARD_PROXY_SECRET=
OPERATOR_DEVICE_IPS=

# --- Optional: governor and planner -------------------------------------------

# Claude's own UI has no $ figure and no API, only a whole-number % remaining
# for the weekly and 5h session windows, so the operator records that % by
# hand (PWA's Governor view, or `work usage observe`) and these knobs decide
# what the governor does with it. See app/src/governor.ts.
# GOVERNOR_RESERVE_FLOOR_PERCENT=30
# GOVERNOR_OVER_RATE_THRESHOLD_PERCENT=25
# GOVERNOR_DANGER_THRESHOLD_PERCENT=10
# GOVERNOR_CRITICAL_THRESHOLD_PERCENT=0
# GOVERNOR_PRIORITY_GATE=5
# Weekly reset day (0=Sunday) and hour, server-local time.
# GOVERNOR_RESET_DAY_OF_WEEK=5
# GOVERNOR_RESET_HOUR=16
# $-based planner fallbacks, used until they are set from the Plan screen
# (stored in the database from then on). What one 5h window is worth in $, and
# the cold-start per-task estimate before a project has history to average.
# GOVERNOR_SESSION_BUDGET_USD=15
# GOVERNOR_DEFAULT_TASK_COST_USD=1.25
# GOVERNOR_CONCURRENCY_GLOBAL=1
# GOVERNOR_CONCURRENCY_PER_AGENT=1
# GOVERNOR_CONCURRENCY_PER_PROJECT=1
# GOVERNOR_CONCURRENCY_PER_PROVIDER=2
