{
  "name": "pinboard-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "DATABASE_URL=postgresql://test:test@localhost:5432/test node --import tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@rackmarten/server-kit": "^0.10.0",
    "drizzle-orm": "^0.36.4",
    "fastify": "^5.1.0",
    "nodemailer": "^6.9.16",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/nodemailer": "^6.4.16",
    "drizzle-kit": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
